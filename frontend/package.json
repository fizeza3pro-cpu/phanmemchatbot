{
  "name": "pipilabu-chatbot-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "\u003e=24"
  },
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck \u0026\u0026 vite build",
    "preview": "vite preview --host localhost --port 5173 --strictPort",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json index.html"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
